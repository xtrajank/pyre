{
  "_comment": [
    "Production instance. Diff this against poc.json - it is the whole POC->prod",
    "change, and it is entirely values. See docs/poc/to-production.md.",
    "",
    "Nothing secret in git: TORQ_PROD_TOKEN is a Key Vault reference the platform",
    "resolves at runtime, and the URLs come from pipeline variables."
  ],

  "PYRE_ENV": "prod",

  "STATE_BACKEND": "redis",
  "REDIS_HOST": "${REDIS_HOST}",
  "REDIS_PORT": "6380",
  "REDIS_USE_ENTRA": "true",

  "LOG_TYPE_FIELD": "dataset",
  "EVENT_TIME_FIELD": "_time",
  "EVENT_ENVELOPE_FIELD": "",

  "EVENTHUB_NAMES": "",

  "BUNDLE_MODE": "blob",
  "BUNDLE_BLOB_ACCOUNT_URL": "https://${STORAGE_ACCOUNT}.blob.core.windows.net",
  "REFRESH_INTERVAL_SECONDS": "45",

  "OUTPUT_BLOB_ACCOUNT_URL": "",
  "SIGNALS_SINK_URL": "${SIGNALS_SINK_URL}",

  "DEFAULT_ROUTES": "torq_prod",
  "TORQ_PROD_URL": "${TORQ_PROD_URL}",
  "TORQ_PROD_TOKEN": "@Microsoft.KeyVault(SecretUri=${KEYVAULT_URI}secrets/torq-prod-token/)",

  "STORM_LIMIT": "1000",
  "AzureFunctionsJobHost__extensions__eventHubs__maxEventBatchSize": "256"
}
