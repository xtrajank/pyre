{
  "_comment": [
    "Copy to local.settings.json (gitignored) to run the Function App locally with",
    "VS Code / Core Tools. Not needed for `python tools/run_local.py` or `pytest`,",
    "which need no Azure at all.",
    "",
    "THIS FILE CONFIGURES NOTHING IN AZURE. The deployed app reads App settings in",
    "the portal (Function App -> Settings -> Environment variables). This is the",
    "same list for a local host, and keeping the two in sync is the only reason to",
    "maintain it. Every setting is documented in docs/configuration.md.",
    "",
    "Running locally joins the consumer group for real, so give the local run its",
    "own `consumer_group:` in config/sources.yaml or it will steal partitions from",
    "the deployed app. See docs/troubleshooting.md."
  ],
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "python",

    "//": "Azurite must be RUNNING before F5 - the Event Hub trigger keeps its checkpoints here.",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",

    "//INSTANCE_LABEL": "Free text, echoed by /health. Nothing reads it.",
    "INSTANCE_LABEL": "prod",
    "//LOG_LEVEL": "DEBUG|INFO|WARNING|ERROR. INFO is one line per batch.",
    "LOG_LEVEL": "INFO",

    "//AZURE_CLIENT_ID": "User-assigned identity only. Empty locally: `az login` is the identity.",
    "AZURE_CLIENT_ID": "",

    "//EVENTHUB_<NS>": "One pair per `namespace:` in sources.yaml; the name is derived from it.",
    "//EVENTHUB_<NS>__credential": "Set to `managedidentity` IN AZURE ONLY - it fails locally.",
    "EVENTHUB_PYRE_EVNTHUB__fullyQualifiedNamespace": "<namespace>.servicebus.windows.net",

    "//DETECTIONS_SOURCE": "blob|local. `local` reads DETECTIONS_LOCAL_DIR off disk.",
    "DETECTIONS_SOURCE": "blob",
    "//DETECTIONS_LOCAL_DIR": "Used only when DETECTIONS_SOURCE=local.",
    "DETECTIONS_LOCAL_DIR": "./dac",
    "//DETECTIONS_BLOB_*": "Used only when DETECTIONS_SOURCE=blob.",
    "DETECTIONS_BLOB_ACCOUNT_URL": "https://<account>.blob.core.windows.net",
    "DETECTIONS_CONTAINER": "detections",
    "DETECTIONS_POINTER": "current.json",
    "//DETECTIONS_REFRESH_SECONDS": "How fast a published detection goes live.",
    "DETECTIONS_REFRESH_SECONDS": "30",

    "//SIGNAL_DESTINATION": "blob|http|none. Every match; high volume. See docs/configuring-destinations.md.",
    "SIGNAL_DESTINATION": "blob",
    "SIGNAL_BLOB_ACCOUNT_URL": "https://<account>.blob.core.windows.net",
    "SIGNAL_BLOB_CONTAINER": "pyre-output",
    "//SIGNAL_HTTP_*": "Used only when SIGNAL_DESTINATION=http. AUTH_HEADER is sent whole as Authorization.",
    "SIGNAL_HTTP_URL": "",
    "SIGNAL_HTTP_AUTH_HEADER": "",
    "//SIGNAL_HTTP_BATCH": "true = one POST per batch (a lake). false = one per record.",
    "SIGNAL_HTTP_BATCH": "true",

    "//ALERT_DESTINATION": "blob|http|none. Deduplicated; low volume; what opens a case.",
    "ALERT_DESTINATION": "blob",
    "ALERT_BLOB_ACCOUNT_URL": "https://<account>.blob.core.windows.net",
    "ALERT_BLOB_CONTAINER": "pyre-output",
    "ALERT_HTTP_URL": "",
    "//ALERT_HTTP_AUTH_HEADER": "In Azure, set this to a Key Vault reference - it is the one secret here.",
    "ALERT_HTTP_AUTH_HEADER": "",
    "//ALERT_HTTP_BATCH": "false = one POST per alert, which is what a case tool wants.",
    "ALERT_HTTP_BATCH": "false",
    "HTTP_TIMEOUT_SECONDS": "10",

    "//STATE_BACKEND": "memory|redis. `redis` shares dedup/thresholds across workers.",
    "STATE_BACKEND": "memory",
    "REDIS_HOST": "",
    "REDIS_PORT": "6380",
    "//ALERT_STORM_LIMIT_PER_HOUR": "Max alerts per detection per hour. Past it: alerts dropped, signals kept.",
    "ALERT_STORM_LIMIT_PER_HOUR": "1000",

    "//AzureFunctionsJobHost__...": "Overrides host.json without a redeploy.",
    "AzureFunctionsJobHost__extensions__eventHubs__maxEventBatchSize": "50"
  }
}
