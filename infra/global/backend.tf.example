# Terraform state backend.
#
# Ships DISABLED, so `terraform init` uses LOCAL state out of the box (writes a
# terraform.tfstate file) - good for a first deploy or a throwaway lab.
#
# For prod / shared / multi-instance, switch to REMOTE state: bootstrap a storage
# account ONCE (Terraform can't create the account that holds its own state - see
# tools/DEPLOY.md or infra/global/backend.tf.example), fill in its name below,
# UNCOMMENT the block, and init with -backend-config="key=<instance>.tfstate".
terraform {
  # backend "azurerm" {
  #   resource_group_name  = "rg-pyre-tfstate"
  #   storage_account_name = "<your-state-account>" # globally unique; bootstrapped out of band
  #   container_name       = "tfstate"
  #   use_azuread_auth     = true # Entra auth, no account keys
  # }
}
